{
  "version": 2,
  "name": "fluent-blended-app",
  "framework": null,
  "public": false,
  "functions": {},
  "builds": [
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    },
    {
      "src": "/",
      "dest": "/frontend/index.html"
    }
  ],
  "outputDirectory": "frontend",
  "github": {
    "enabled": true,
    "silent": true,
    "autoJobCancelation": true
  },
  "git": {
    "deploymentEnabled": {
      "main": true,
      "with_libm": true
    }
  }
}
